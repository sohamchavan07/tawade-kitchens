# ==============================================================================
# Tawade Kitchen - Backend Rails API Environment Configuration Template
# Copy this file to .env for local development.
# ==============================================================================

# Rails Environment
RAILS_ENV=development
PORT=3000

# Secret Key Base (Generate with `bin/rails secret` in production)
# SECRET_KEY_BASE=your_secret_key_base_here

# PostgreSQL Database Connection URL (Replace with your local or Neon connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/tawade_kitchen_development

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tawade-kitchen.vercel.app,https://tawade-kitchens.onrender.com

# Business Configuration
TAWADE_BUSINESS_NAME="Tawade Kitchen"
TAWADE_PICKUP_ADDRESS="Plot no 7, Mukt Sainik Vasahat, Opp Mukt Sainik Udyan, PO: Gur Market Yard, Kolhapur, Maharashtra 416005"
TAWADE_MAPS_URL="https://maps.app.goo.gl/fE2oV7vcLptDP2hr6"
TAWADE_WHATSAPP_NUMBER="9860002903"
TAWADE_UPI_ID="tawadekitchen@upi"

# OAuth Credentials (Optional)
#GOOGLE_CLIENT_ID=your_google_client_id_here
#GOOGLE_CLIENT_SECRET=your_google_client_secret_here