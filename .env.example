# ==============================================================================
# Tawade Kitchen - Backend Rails API Environment Configuration Template
# NOTE: Copy this file to .env and replace with your actual environment values.
# NEVER commit .env containing real credentials or production secrets to git.
# ==============================================================================

# Rails Environment
RAILS_ENV=development
PORT=3000

# Secret Key Base (Generate with `bin/rails secret` in production)
# SECRET_KEY_BASE=your_secret_key_base_here

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=soham
DATABASE_PASSWORD=
DATABASE_NAME_DEV=react_ror_development
DATABASE_NAME_TEST=react_ror_test
# Or use full connection URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/react_ror_production

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Example: http://localhost:8080,http://localhost:5173,https://tawade-kitchen.vercel.app
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,https://react-ror.onrender.com

# Business Schedule & Configuration (Optional overrides for pickup_schedule.rb)
TAWADE_BUSINESS_NAME="Tawade Kitchen"
TAWADE_PICKUP_ADDRESS="Plot no 7, Mukt Sainik Vasahat, Opp Mukt Sainik Udyan, PO: Gur Market Yard, Kolhapur, Maharashtra 416005"
TAWADE_MAPS_URL="https://maps.app.goo.gl/fE2oV7vcLptDP2hr6"
TAWADE_WHATSAPP_NUMBER="9860002903"
TAWADE_UPI_ID="tawadekitchen@upi"
